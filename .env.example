# Supabase — Tribes data/auth project (pnlknurdxcduhbtxdefl)
# Get real values from the Supabase dashboard: Project Settings → API
# Copy this file to .env.local and fill in the values.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — safe to expose to the browser, respects RLS
# Use the modern sb_publishable_... format for new applications
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER-ONLY, BYPASSES RLS
# Never commit. Never prefix with NEXT_PUBLIC_. Never import from a client component.
# Only used inside src/lib/supabase/admin.ts, gated by requireAdmin().
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 measurement ID for the trytribes.com web stream.
# Optional — src/lib/analytics.ts falls back to the live ID (G-JDM03V14GB) if unset.
# Set this only to point a deploy at a different GA4 property (e.g. a staging stream).
# GA4 loads in production only and is skipped on /admin (see Analytics.tsx).
NEXT_PUBLIC_GA_ID=

# GoHighLevel Inbound Webhook URL for /api/feedback submissions.
# Optional — if unset, the feedback route accepts the submission and logs it
# (fail-open, no data forwarded). Set it to forward F&F feedback into GHL.
#
# ⚠️ This is currently UNSET in Vercel production, which means every in-app
# feedback submission since launch has been silently discarded (the route takes
# its fail-open branch and returns {ok:true, forwarded:false}). Set it.
GHL_FEEDBACK_WEBHOOK_URL=

# ── GoHighLevel Contacts sync (waitlist leads → CRM) ─────────────────────────
# ⚠️ NAMESPACED ON PURPOSE — do NOT rename these to plain GHL_PIT / GHL_LOCATION_ID.
# SoTech runs its own GoHighLevel account and dev machines commonly export generic
# GHL_LOCATION_ID / GHL_PIT_TOKEN for it. Next.js gives real environment variables
# precedence over .env.local, so a generic name gets silently overridden by the
# shell — which is how a Tribes token ended up paired with SoTech's location id
# during development. A matching generic pair would have written Tribes' leads
# into SoTech's CRM without erroring.
#
# Private Integration Token for the TRIBES GHL location. SERVER-SIDE ONLY
# (src/lib/ghl.ts). Scope it to exactly: contacts.readonly + contacts.write.
# Deliberately a SEPARATE token from the email-template tooling PIT: this one runs
# in production on every waitlist submission, so it must be independently
# rotatable and must not be able to touch email templates.
#
# Optional — if unset, /api/waitlist still captures the lead in Supabase and just
# skips the CRM mirror (fail-open). Never prefix with NEXT_PUBLIC_.
TRIBES_GHL_PIT=

# Tribes GHL location id (sub-account). Required alongside TRIBES_GHL_PIT.
TRIBES_GHL_LOCATION_ID=
