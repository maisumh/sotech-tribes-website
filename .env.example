# Supabase — Tribes data/auth project (pnlknurdxcduhbtxdefl)
# Get real values from the Supabase dashboard: Project Settings → API
# Copy this file to .env.local and fill in the values.

# Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — safe to expose to the browser, respects RLS
# Use the modern sb_publishable_... format for new applications
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER-ONLY, BYPASSES RLS
# Never commit. Never prefix with NEXT_PUBLIC_. Never import from a client component.
# Only used inside src/lib/supabase/admin.ts, gated by requireAdmin().
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 measurement ID for the trytribes.com web stream.
# Optional — src/lib/analytics.ts falls back to the live ID (G-JDM03V14GB) if unset.
# Set this only to point a deploy at a different GA4 property (e.g. a staging stream).
# GA4 loads in production only and is skipped on /admin (see Analytics.tsx).
NEXT_PUBLIC_GA_ID=

# GoHighLevel Inbound Webhook URL for /api/feedback submissions.
# Optional — if unset, the feedback route accepts the submission and logs it
# (fail-open, no data forwarded). Set it to forward F&F feedback into GHL.
GHL_FEEDBACK_WEBHOOK_URL=
